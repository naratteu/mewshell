<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Naratteu.MewShell.Razor</PackageId>
    <Description>UseCommand for MewRazor: a command that re-runs when the values interpolated into it change, plus typed list, drop-down and table components.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MewShell/MewShell.csproj" />
    <!-- PrivateAssets="none": by default a package reference keeps its analyzers to itself, and
         whoever installs this package should get MewRazor's MEW001 check too. -->
    <PackageReference Include="Naratteu.MewUI.Razor" Version="0.1.0-preview.1" PrivateAssets="none" />
  </ItemGroup>

</Project>

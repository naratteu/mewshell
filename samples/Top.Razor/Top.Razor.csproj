<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI.MacOS" Version="0.21.1" />
    <PackageReference Include="R3" Version="1.3.1" />
    <ProjectReference Include="../../src/MewShell/MewShell.csproj" />
    <PackageReference Include="Naratteu.MewUI.Razor" Version="0.1.0-preview.1" />
  </ItemGroup>

</Project>
